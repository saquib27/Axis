{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "backend/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.next",
    "frontend"
  ]
}
