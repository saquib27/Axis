{
  "name": "axis-pay",
  "version": "0.2.0",
  "description": "Drop-in client for atomic multi-provider x402 payments on Algorand. One call pays N APIs atomically and returns a unified receipt.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "logo.svg"
  ],
  "keywords": [
    "x402",
    "algorand",
    "agent",
    "payments",
    "usdc",
    "atomic"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "example": "node example.ts",
    "prepublishOnly": "npm run build"
  }
}
